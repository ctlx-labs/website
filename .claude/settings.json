{
  "permissions": {
    "allow": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(npm run:*)",
      "Bash(python3:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin --delete:*)"
    ],
    "ask": [
      "Bash(gh repo delete:*)",
      "Bash(gh repo rename:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh repo edit --visibility:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_records.py\""
          }
        ]
      },
      {
        "matcher": "mcp__hearthbot__post_message|mcp__hearthbot__request_decision|mcp__slackbot__post_message|mcp__slackbot__reply",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_rules.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_rules.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
